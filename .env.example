# Copie este arquivo para .env.local e preencha. NUNCA suba o .env.local para o GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# ---------- Obrigatórias ----------

# Supabase > Project Settings > API: "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase > Project Settings > API: chave "anon" (pública)
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
# Supabase > Project Settings > API: chave "service_role" (secreta, só no servidor)
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-service-role-aqui
# Chave que cifra os cabeçalhos de webhook guardados no banco. 32 bytes em base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Não troque depois de usar (o que já foi cifrado deixa de abrir).
CRYPTO_KEY=gere-com-o-comando-acima
# Segredo que assina o acesso de cada participante à sala. Gere do mesmo jeito que a CRYPTO_KEY.
SALA_TOKEN_SECRET=gere-um-valor-aleatorio
# Senha que o agendador (cron da Vercel) usa para chamar /api/cron/tick e /api/cron/ia.
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=gere-um-valor-aleatorio
# Endereço do painel (onde você e a equipe entram). No seu computador: http://localhost:3000
NEXT_PUBLIC_PAINEL_URL=https://painel.seu-dominio.com.br
# Endereço da sala (o link que vai para o público). Precisa ser um domínio DIFERENTE do painel.
# No seu computador: http://sala.localhost:3000
NEXT_PUBLIC_SALA_URL=https://aula.seu-dominio.com.br

# ---------- Opcionais ----------

# Nome que aparece no painel (logo do menu e título da aba). Sem ela: "Vórtex Webinar".
NEXT_PUBLIC_NOME_SISTEMA=

# Bunny Stream (envio e hospedagem de vídeos). Sem as três, o envio de vídeo fica desligado
# e você usa só link externo (YouTube, Vimeo, arquivo .mp4/.m3u8).
# Bunny > Stream > sua biblioteca > API: "Video Library ID"
BUNNY_STREAM_LIBRARY_ID=
# Bunny > Stream > sua biblioteca > API: "API Key" da biblioteca
BUNNY_STREAM_API_KEY=
# Bunny > Stream > sua biblioteca > API: "CDN Hostname" (algo como vz-xxxxxxxx-xxx.b-cdn.net)
BUNNY_STREAM_CDN_HOST=
# Palavra secreta que vai no endereço do webhook do Bunny (avisa quando o vídeo terminou de processar).
# Webhook no Bunny: https://painel.seu-dominio.com.br/api/bunny/webhook/<BUNNY_WEBHOOK_TOKEN>
BUNNY_WEBHOOK_TOKEN=
# Endereço mandado como "Referer" ao buscar a capa do vídeo no Bunny. Sem ela, usa NEXT_PUBLIC_SALA_URL.
SALA_URL=

# IA (gerar o chat simulado a partir do vídeo e o agente que responde na sala). Sem as duas primeiras, fica desligado.
# OpenRouter > Keys
OPENROUTER_API_KEY=
# Modelo (ou vários separados por vírgula: o primeiro é o principal, os outros são reserva).
# Ex.: anthropic/claude-sonnet-4.5
OPENROUTER_TEXT_MODEL=
# ElevenLabs > API Keys. Só a transcrição do vídeo (para gerar o chat) precisa dela.
ELEVENLABS_API_KEY=

# E-mails do "just in time" (inscrição confirmada, lembrete e "estamos começando") pelo Resend.
# Resend > API Keys
RESEND_API_KEY=
# Remetente, num domínio verificado no Resend. Ex.: aulas@seu-dominio.com.br
EMAIL_FROM=
